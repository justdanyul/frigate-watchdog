# /etc/frigate-watchdog.env  (chmod 600 - may contain the MQTT password)

FRIGATE_URL=http://127.0.0.1:5000
GO2RTC_URL=http://127.0.0.1:1984

# Per-camera bounce via MQTT. Leave MQTT_HOST empty to skip straight to
# restarting go2rtc.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_PREFIX=frigate

# Timings (seconds)
STALE_SECONDS=300
CHECK_INTERVAL=60
GRACE_SECONDS=240
STARTUP_GRACE=300
GLOBAL_COOLDOWN=900

# Set to 0 to never let the watchdog restart Frigate itself.
ALLOW_FRIGATE_RESTART=1
